[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

; Low-end target: OpenGL 3.3 / GLES3 compatibility backend.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; MSAA is the single most expensive knob on integrated GPUs -> off.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/use_debanding=false
; One small shadow atlas shared by every shadow caster.
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.06, 1)
