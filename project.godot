; =============================================================================
;  NeonOverdrive - Godot 4.3+ (.NET) project configuration
;  Low-end PC target: OpenGL Compatibility renderer, no MSAA, 1024px shadows.
;  Every gameplay node/resource is created in C# (see Scripts/Utils/SceneBuilder.cs).
; =============================================================================

config_version=5

[application]

config/name="NeonOverdrive"
config/description="Lightweight 3D arcade vehicular combat racing."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "C#", "GL Compatibility")

[dotnet]

project/assembly_name="ApexCombatRacing"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[input]

accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
]
}
